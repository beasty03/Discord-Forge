# Discord OAuth2
# Create app at: https://discord.com/developers/applications
# Under OAuth2 → Redirects, add BOTH of these:
#   http://<your-ip>:5000/auth/discord/callback
#   http://127.0.0.1:5000/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://<your-ip>:5000/auth/discord/callback
DISCORD_REDIRECT_URI_LOCAL=http://127.0.0.1:5000/auth/discord/callback

# Google OAuth2 — disabled by default
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub OAuth2
GITHUB_TOKEN=

# hCaptcha — https://dashboard.hcaptcha.com
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Bot runner mode
# subprocess (default) — bots run as local processes via the downloaded bot_manager package
# docker             — bots run as sibling Docker containers (requires Docker socket mounted)
BOT_RUNNER=subprocess

# Docker mode settings (only used when BOT_RUNNER=docker)
# BOT_IMAGE         — name of the bot Docker image (build from discord-server-setup-template/)
# DOCKER_NETWORK    — compose network name the bot containers should join
# FORGE_API_URL     — URL the bot containers use to reach this Flask app
BOT_IMAGE=discordforge-bot
DOCKER_NETWORK=discordforge_default
FORGE_API_URL=http://discordforge:5000

# SMTP — for password reset emails
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=app-password
# Leave blank to disable email features
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Bot token encryption key (Fernet) — generate once, never change or existing tokens break
# Generate: py -3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Set to true when running behind HTTPS in production
SESSION_COOKIE_SECURE=false
